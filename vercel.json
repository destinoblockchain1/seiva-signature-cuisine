{
  "version": 2,
  "outputDirectory": "dist/client",
  "crons": [
    {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
